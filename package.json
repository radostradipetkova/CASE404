{
  "name": "case-404-digital-forensics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply case404 --local",
    "db:migrate:remote": "wrangler d1 migrations apply case404 --remote",
    "db:seed:local": "wrangler d1 execute case404 --local --file=./scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute case404 --remote --file=./scripts/seed.sql",
    "check": "node --check src/worker.js && node --check public/app.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
